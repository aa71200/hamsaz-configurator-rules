          "type": "count",
          "component": "camera"
        },
        "right": {
          "type": "attribute",
          "component": "recorder",
          "attribute": "channels"
        }
      },
      "code": "CHANNEL_CAPACITY"
    }
  ],
  "questions": [],
  "profiles": [],
  "layout": {
