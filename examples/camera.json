      "id": "protocol",
      "label": "پروتکل تصویر",
      "type": "string",
      "required": true,
      "componentIds": [
        "camera",
        "recorder"
      ]
    },
    {
      "id": "channels",
      "label": "تعداد کانال",
      "type": "integer",
      "required": true,
      "componentIds": [
        "recorder"
      ]
    }
  ],
  "mappings": {},
