{
  "schemaVersion": 1,
  "title": "بستهٔ دوربین و ضبط",
  "description": "نمونهٔ قابل‌ویرایش برای انتخاب دوربین، ضبط‌کننده و خدمات نصب.",
  "locale": "fa",
  "components": [
    {
      "id": "camera",
      "label": "دوربین",
